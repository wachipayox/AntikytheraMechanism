{
  "multipart": [
    { "when": { "facing": "north" }, "apply": { "model": "antikytheramechanism:block/transmission_box_chassis", "uvlock": true } },
    { "when": { "facing": "east" }, "apply": { "model": "antikytheramechanism:block/transmission_box_chassis", "y": 90, "uvlock": true } },
    { "when": { "facing": "south" }, "apply": { "model": "antikytheramechanism:block/transmission_box_chassis", "y": 180, "uvlock": true } },
    { "when": { "facing": "west" }, "apply": { "model": "antikytheramechanism:block/transmission_box_chassis", "y": 270, "uvlock": true } },
    { "when": { "facing": "up" }, "apply": { "model": "antikytheramechanism:block/transmission_box_chassis", "x": 270, "uvlock": true } },
    { "when": { "facing": "down" }, "apply": { "model": "antikytheramechanism:block/transmission_box_chassis", "x": 90, "uvlock": true } },

    { "when": { "facing": "north", "diagonal_b": "false" }, "apply": { "model": "antikytheramechanism:block/two_small_cog_transmission_box_ports_a", "uvlock": true } },
    { "when": { "facing": "east", "diagonal_b": "false" }, "apply": { "model": "antikytheramechanism:block/two_small_cog_transmission_box_ports_a", "y": 90, "uvlock": true } },
    { "when": { "facing": "south", "diagonal_b": "false" }, "apply": { "model": "antikytheramechanism:block/two_small_cog_transmission_box_ports_a", "y": 180, "uvlock": true } },
    { "when": { "facing": "west", "diagonal_b": "false" }, "apply": { "model": "antikytheramechanism:block/two_small_cog_transmission_box_ports_a", "y": 270, "uvlock": true } },
    { "when": { "facing": "up", "diagonal_b": "false" }, "apply": { "model": "antikytheramechanism:block/two_small_cog_transmission_box_ports_a", "x": 270, "uvlock": true } },
    { "when": { "facing": "down", "diagonal_b": "false" }, "apply": { "model": "antikytheramechanism:block/two_small_cog_transmission_box_ports_a", "x": 90, "uvlock": true } },

    { "when": { "facing": "north", "diagonal_b": "true" }, "apply": { "model": "antikytheramechanism:block/two_small_cog_transmission_box_ports_b", "uvlock": true } },
    { "when": { "facing": "east", "diagonal_b": "true" }, "apply": { "model": "antikytheramechanism:block/two_small_cog_transmission_box_ports_b", "y": 90, "uvlock": true } },
    { "when": { "facing": "south", "diagonal_b": "true" }, "apply": { "model": "antikytheramechanism:block/two_small_cog_transmission_box_ports_b", "y": 180, "uvlock": true } },
    { "when": { "facing": "west", "diagonal_b": "true" }, "apply": { "model": "antikytheramechanism:block/two_small_cog_transmission_box_ports_b", "y": 270, "uvlock": true } },
    { "when": { "facing": "up", "diagonal_b": "true" }, "apply": { "model": "antikytheramechanism:block/two_small_cog_transmission_box_ports_b", "x": 270, "uvlock": true } },
    { "when": { "facing": "down", "diagonal_b": "true" }, "apply": { "model": "antikytheramechanism:block/two_small_cog_transmission_box_ports_b", "x": 90, "uvlock": true } }
  ]
}
